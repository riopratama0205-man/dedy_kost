@push('scripts')
    <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const bookedDates = @json($bookedDates);
            const disableDates = bookedDates.map(booking => {
                return {
                    from: booking.start_date,
                    to: booking.end_date
                };
            });

            // Inline Calendar (Visual Only)
            flatpickr("#availabilityCalendar", {
                inline: true,
                mode: "range",
                minDate: "today",
                dateFormat: "Y-m-d",
                disable: disableDates,
                clickOpens: false,
                allowInput: false,
                className: "read-only-flatpickr",
                onDayCreate: function (dObj, dStr, fp, dayElem) {
                    dayElem.style.pointerEvents = 'none';
                    dayElem.style.cursor = 'default';
                }
            });

            // Input Pickers (Interactive)
            const checkin = flatpickr("#checkin", {
                minDate: "today",
                dateFormat: "Y-m-d",
                disable: disableDates,
                onChange: function (selectedDates, dateStr, instance) {
                    checkout.set('minDate', dateStr);
                }
            });

            const checkout = flatpickr("#checkout", {
                minDate: "today",
                dateFormat: "Y-m-d",
                disable: disableDates
            });
        });
    </script>
@endpush
