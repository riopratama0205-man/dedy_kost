        .flatpickr-next-month:hover {
            fill: #0891b2 !important;
        }

        /* Weekday Headers */
        .flatpickr-weekdays {
            background: #f8fafc !important;
            padding: 0.5rem 0 !important;
        }

        .flatpickr-weekday {
            color: #64748b !important;
            font-weight: 600 !important;
            font-size: 0.875rem !important;
        }

        /* Days Container */
        .flatpickr-days {
            width: 100% !important;
            padding: 1rem !important;
        }

        .dayContainer {
            width: 100% !important;
            min-width: 100% !important;
            max-width: 100% !important;
        }

        /* Individual Days */
        .flatpickr-day {
            height: 3rem !important;
            line-height: 3rem !important;
            border-radius: 0.5rem !important;
            border: 1px solid transparent !important;
            margin: 0.125rem !important;
            font-size: 0.9375rem !important;
            font-weight: 500 !important;
            color: #334155 !important;
        }

        .flatpickr-day.today {
            background: #e0f2fe !important;
            border-color: #0891b2 !important;
            max-width: 320px !important;
            border-radius: 12px !important;
        }

        .flatpickr-calendar:not(.inline) .flatpickr-months {
            padding: 0.75rem !important;
        }

        .flatpickr-calendar:not(.inline) .flatpickr-current-month {
            font-size: 1rem !important;
            padding: 0.25rem 0 !important;
        }

        .flatpickr-calendar:not(.inline) .flatpickr-current-month .flatpickr-monthDropdown-months,
        .flatpickr-calendar:not(.inline) .flatpickr-current-month .cur-year {
            font-size: 1rem !important;
        }

        .flatpickr-calendar:not(.inline) .flatpickr-weekday {
            font-size: 0.75rem !important;
        }

        .flatpickr-calendar:not(.inline) .flatpickr-days {
            padding: 0.5rem !important;
        }

        .flatpickr-calendar:not(.inline) .flatpickr-day {
            height: 2.25rem !important;
            line-height: 2.25rem !important;
            max-width: 2.25rem !important;
            font-size: 0.875rem !important;
